TZ=Europe/Berlin
BASE_URL=https://library.example.com
# ADMIN_EMAIL=you@example.com
# ADMIN_PASSWORD=change-me-please
# Libraries made on the first start (paths inside the container)
LIBRARIES=Books=/books;Comics@comics=/comics;Manga@manga=/manga
# INGEST_DIR=/ingest
# Send to Kindle: your mail account (add SMTP_FROM to Amazon's approved senders)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_TLS=starttls
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=kindle@example.com
# SMTP_FROM_NAME=Pocket Library
# KINDLE_EMAIL=you_123@kindle.com
# GOOGLE_BOOKS_API_KEY=
# NOTIFY_URL=http://apprise:8000/notify/library
# Importing from the apps this replaces (read-only mounts)
# CALIBRE_WEB_DB=/import/calibre-web/app.db
# CALIBRE_DB=/import/calibre/metadata.db
# KAVITA_DB=/import/kavita/kavita.db
# Pocket Core
# CORE_URL=http://pocket-core:8080
# CORE_REGISTRATION_KEY=
